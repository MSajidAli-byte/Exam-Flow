# Exam-Flow Environment Configuration

# ============================================================================
# REQUIRED: Google Gemini API Key
# ============================================================================
# Get your API key from: https://aistudio.google.com/
GOOGLE_API_KEY=your_google_api_key_here

# ============================================================================
# PHASE CONTROL (Milestone 1 vs Milestone 2)
# ============================================================================
# PHASE=1 : Stable production version (Core AI Grading & Proctoring)
# PHASE=2 : Development version (Agentic AI with RAG)
PHASE=1

# ============================================================================
# AGENTIC AI MODE (Phase 2 Feature)
# ============================================================================
# AGENTIC_MODE=off : Standard AI grading (Milestone 1)
# AGENTIC_MODE=on  : Enable RAG-based ideal solution comparison (Milestone 2)
AGENTIC_MODE=off

# ============================================================================
# BACKEND CONFIGURATION
# ============================================================================
# Backend API URL (used by frontend)
BACKEND_URL=http://backend:8000

# ============================================================================
# OPTIONAL: Advanced Settings
# ============================================================================
# Uncomment and configure as needed for Phase 2

# ChromaDB Collection Name
# CHROMA_COLLECTION=ideal_solutions

# Embedding Model for RAG
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Maximum number of ideal solutions to retrieve
# RAG_TOP_K=3

# Enable debug logging
# DEBUG=false

# ============================================================================
# DEVELOPMENT NOTES
# ============================================================================
# 1. Copy this file to .env and fill in your actual values
# 2. Never commit .env to Git (it's in .gitignore)
# 3. For Phase 2 testing, set PHASE=2 and AGENTIC_MODE=on
# 4. To rollback to stable, set PHASE=1 and AGENTIC_MODE=off
